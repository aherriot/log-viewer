<% content_for :title, "Log Viewer" %>

<style>
  body { font-family: -apple-system, sans-serif; margin: 2rem; color: #222; }
  form { margin-bottom: 1.5rem; display: flex; gap: 0.75rem; align-items: end; flex-wrap: wrap; }
  form label { display: flex; flex-direction: column; font-size: 0.8rem; color: #555; gap: 0.25rem; }
  form label.checkbox { flex-direction: row; align-items: center; gap: 0.4rem; }
  input[type="text"], input[type="datetime-local"] { font-size: 1rem; padding: 0.4rem; }
  input[type="text"].q { width: 20rem; }
  input[type="text"].ip { width: 10rem; }
  button { font-size: 1rem; padding: 0.4rem 0.8rem; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #ddd; font-size: 0.9rem; }
  th { background: #f5f5f5; }
  .level-error { color: #b00020; font-weight: bold; }
  .level-warn { color: #b06000; }
  .rank { color: #666; font-variant-numeric: tabular-nums; }
</style>

<h1>Log Viewer</h1>

<%= form_with url: logs_path, method: :get do %>
  <label>
    Search
    <%= text_field_tag :q, @query, placeholder: "Search messages…", class: "q" %>
  </label>
  <label>
    From
    <%= datetime_field_tag :from, @from %>
  </label>
  <label>
    To
    <%= datetime_field_tag :to, @to %>
  </label>
  <label>
    IP
    <%= text_field_tag :ip, @ip, placeholder: "1.2.3.4", class: "ip" %>
  </label>
  <label class="checkbox">
    <%= check_box_tag :errors_only, "1", ActiveModel::Type::Boolean.new.cast(@errors_only) %>
    Errors only
  </label>
  <%= button_tag "Filter" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Time</th>
      <th>Level</th>
      <th>Status</th>
      <th>HTTP</th>
      <th>User</th>
      <th>IP</th>
      <th>Message</th>
      <% if @query.present? %><th>Rank</th><% end %>
    </tr>
  </thead>
  <tbody>
    <% @logs.each do |log| %>
      <tr>
        <td><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td class="level-<%= log.level %>"><%= log.level %></td>
        <td><%= log.status %></td>
        <td><%= log.http_status %></td>
        <td><%= log.user_id %></td>
        <td><%= log.ip %></td>
        <td><%= log.message %></td>
        <% if @query.present? %><td class="rank"><%= log.rank.round(4) %></td><% end %>
      </tr>
    <% end %>
  </tbody>
</table>
