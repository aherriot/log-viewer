<% content_for :title, "Log Viewer" %>

<style>
  body { font-family: -apple-system, sans-serif; margin: 2rem; color: #222; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #ddd; font-size: 0.9rem; vertical-align: top; }
  th { background: #f5f5f5; }
  th .col-header { display: flex; flex-direction: column; gap: 0.3rem; }
  th a { color: inherit; text-decoration: none; font-weight: bold; }
  th a:hover { text-decoration: underline; }
  th input[type="text"], th input[type="number"], th input[type="date"], th select {
    font-size: 0.85rem; padding: 0.25rem; width: 100%; box-sizing: border-box; font-weight: normal;
  }
  th input.narrow, th select.narrow { width: 6.5rem; }
  .level-error { color: #b00020; font-weight: bold; }
  .level-warn { color: #b06000; }
  .rank { color: #666; font-variant-numeric: tabular-nums; }
  .pagination { margin-top: 1rem; display: flex; gap: 1rem; align-items: center; }
  .pagination a, .pagination span.disabled { padding: 0.3rem 0.7rem; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #222; }
  .pagination span.disabled { color: #aaa; }
  .banner { padding: 0.6rem 0.9rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem; }
  .banner.error { background: #fdecea; color: #b00020; border: 1px solid #f5c2c0; }
  .banner ul { margin: 0.25rem 0 0 1.2rem; padding: 0; }
  .empty-state { text-align: center; color: #777; padding: 2rem !important; font-style: italic; }
  .table-wrapper { position: relative; }
  form.loading .table-wrapper table { opacity: 0.35; transition: opacity 0.1s ease; }
  .loading-overlay {
    display: none; position: absolute; inset: 0; top: 2.5rem; z-index: 10;
    align-items: center; justify-content: center; gap: 0.6rem;
  }
  form.loading .loading-overlay { display: flex; }
  .spinner {
    width: 1.4rem; height: 1.4rem; border: 3px solid #ccc; border-top-color: #333;
    border-radius: 50%; animation: spin 0.6s linear infinite;
  }
  .loading-text { font-weight: bold; font-size: 1rem; color: #333; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .field-row { display: flex; align-items: center; gap: 0.3rem; }
  .field-row > *:first-child { flex: 1; min-width: 0; }
  .clear-btn {
    flex: none; width: 1.3rem; height: 1.3rem; line-height: 1; padding: 0;
    border: 1px solid #ccc; border-radius: 50%; background: #fff; color: #888;
    cursor: pointer; font-size: 0.85rem;
  }
  .clear-btn:hover { background: #eee; color: #b00020; }
  .header-bar { display: flex; align-items: center; gap: 1rem; }
  .clear-all { font-size: 0.9rem; }
</style>

<div class="header-bar">
  <h1>Log Viewer</h1>
  <% if [@query, @from, @to, @ip, @status, @level, @user_id, @http_status].any?(&:present?) %>
    <%= link_to "Clear all filters", logs_path, class: "clear-all" %>
  <% end %>
</div>

<% if @errors.present? %>
  <div class="banner error">
    <strong><%= @errors.size == 1 ? "There's a problem with your filters:" : "There are problems with your filters:" %></strong>
    <ul>
      <% @errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: logs_path, method: :get, data: { controller: "auto-submit" } do %>
  <div class="table-wrapper">
  <div class="loading-overlay">
    <div class="spinner"></div>
    <span class="loading-text">Loading…</span>
  </div>
  <table>
    <thead>
      <tr>
        <th>
          <div class="col-header">
            <%= sort_link("Time", "created_at", @sort, @dir) %>
            <%= field_with_clear("from", @from) { date_field_tag :from, @from, data: { action: "change->auto-submit#submit" } } %>
            <%= field_with_clear("to", @to) { date_field_tag :to, @to, data: { action: "change->auto-submit#submit" } } %>
          </div>
        </th>
        <th>
          <div class="col-header">
            <%= sort_link("Level", "level", @sort, @dir) %>
            <%= field_with_clear("level", @level) { select_tag :level, options_for_select([["All", ""]] + %w[debug info warn error], @level), data: { action: "change->auto-submit#submit" } } %>
          </div>
        </th>
        <th>
          <div class="col-header">
            <%= sort_link("Status", "status", @sort, @dir) %>
            <%= field_with_clear("status", @status) { select_tag :status, options_for_select([["All", ""], ["ok", "ok"], ["client error", "client_error"], ["server error", "server_error"]], @status), data: { action: "change->auto-submit#submit" } } %>
          </div>
        </th>
        <th>
          <div class="col-header">
            <%= sort_link("HTTP", "http_status", @sort, @dir) %>
            <%= field_with_clear("http_status", @http_status) { select_tag :http_status, options_for_select([["All", ""]] + Log::HTTP_STATUSES.map(&:to_s), @http_status), class: "narrow", data: { action: "change->auto-submit#submit" } } %>
          </div>
        </th>
        <th>
          <div class="col-header">
            <%= sort_link("User", "user_id", @sort, @dir) %>
            <%= field_with_clear("user_id", @user_id) { number_field_tag :user_id, @user_id, class: "narrow", data: { action: "blur->auto-submit#submit keydown.enter->auto-submit#submit" } } %>
          </div>
        </th>
        <th>
          <div class="col-header">
            IP
            <%= field_with_clear("ip", @ip) { text_field_tag :ip, @ip, placeholder: "1.2.3.4 or 10.0.0.0/24", class: "narrow", data: { action: "blur->auto-submit#submit keydown.enter->auto-submit#submit" } } %>
          </div>
        </th>
        <th>
          <div class="col-header">
            Message
            <%= field_with_clear("q", @query) { text_field_tag :q, @query, placeholder: "Search…", data: { action: "input->auto-submit#submitDebounced" } } %>
          </div>
        </th>
        <% if @query.present? %><th>Rank</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% if @logs.empty? %>
        <tr>
          <td class="empty-state" colspan="<%= @query.present? ? 8 : 7 %>">
            <% if @errors.present? %>
              Fix the filters above to see results.
            <% else %>
              No logs match these filters.
            <% end %>
          </td>
        </tr>
      <% else %>
        <% @logs.each do |log| %>
          <tr>
            <td><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
            <td class="level-<%= log.level %>"><%= log.level %></td>
            <td><%= log.status %></td>
            <td><%= log.http_status %></td>
            <td><%= log.user_id %></td>
            <td><%= log.ip %></td>
            <td><%= log.message %></td>
            <% if @query.present? %><td class="rank"><%= log.rank.round(4) %></td><% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  </div>
<% end %>

<div class="pagination">
  <% if @page > 1 %>
    <%= link_to "← Previous", logs_path(request.query_parameters.merge(page: @page - 1)) %>
  <% else %>
    <span class="disabled">← Previous</span>
  <% end %>
  <span>Page <%= @page %></span>
  <% if @has_next %>
    <%= link_to "Next →", logs_path(request.query_parameters.merge(page: @page + 1)) %>
  <% else %>
    <span class="disabled">Next →</span>
  <% end %>
</div>
